{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ScreenR",
  "version": "1.2.1",
  "identifier": "com.bolorundurovb.screenr",
  "build": {
    "beforeDevCommand": "yarn start",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "yarn build",
    "frontendDist": "../dist/screenr/browser"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ScreenR",
        "width": 700,
        "height": 640,
        "minWidth": 420,
        "minHeight": 520,
        "resizable": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$VIDEO/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
